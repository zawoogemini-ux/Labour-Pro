<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Record Cash Advance"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cash payment disbursed will be auto-deducted from wages"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Worker Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Worker"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerAdvanceWorker"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_rounded_card"
        android:backgroundTint="@color/surface_variant" />

    <!-- Amount & Date in Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:hint="Amount (ကြိုထုတ်ငွေ Ks)"
            app:hintTextColor="@color/hint_amount"
            android:textColorHint="@color/hint_amount"
            app:helperText="ပမာဏ (ကျပ်)"
            app:helperTextTextColor="@color/hint_amount"
            app:boxStrokeColor="@color/hint_amount"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAdvanceAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdvanceDatePicker"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Date (ရက်စွဲ)"
            android:textSize="12sp"
            android:textColor="@color/text_main"
            app:icon="@drawable/ic_calendar"
            app:iconTint="@color/primary"
            app:iconSize="16dp" />
    </LinearLayout>

    <!-- Supervisor Name with Colored Hint -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Given By (ကြီးကြပ်ရေးမှူး အမည်)"
        app:hintTextColor="@color/hint_supervisor"
        android:textColorHint="@color/hint_supervisor"
        app:helperText="ထုတ်ပေးသူ ကြီးကြပ်ရေးမှူး အမည် ရိုက်ထည့်ပါ"
        app:helperTextTextColor="@color/hint_supervisor"
        app:boxStrokeColor="@color/hint_supervisor"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdvanceSupervisor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Remark / Purpose with Colored Hint -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Remark / Purpose (မှတ်ချက် / အကြောင်းပြချက်)"
        app:hintTextColor="@color/hint_remark"
        android:textColorHint="@color/hint_remark"
        app:helperText="ဥပမာ- ဆေးကုသစရိတ်၊ စားသောက်စရိတ်"
        app:helperTextTextColor="@color/hint_remark"
        app:boxStrokeColor="@color/hint_remark"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdvanceRemark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAdvance"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAdvance"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Record Advance"
            android:textColor="@color/white"
            app:backgroundTint="@color/secondary" />
    </LinearLayout>
</LinearLayout>
