<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Worker (လုပ်သားသစ် စာရင်းသွင်း)"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto sequential Worker ID • Customizable • Myanmar Kyats (Ks)"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <!-- Worker ID Section Header & Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Worker ID (လုပ်သား ကုဒ်နံပါတ်)"
                android:textColor="@color/hint_worker_id"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWorkerIdStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/badge_auto_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="⚡ Auto Sequence"
                android:textColor="@color/badge_auto_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Worker Code (Auto/Customizable) & Reset Auto Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWorkerCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Worker ID (Auto Sequence / စိတ်ကြိုက်)"
                app:hintTextColor="@color/hint_worker_id"
                android:textColorHint="@color/hint_worker_id"
                app:helperText="Auto Number အစဉ်လိုက် (လိုအပ်ပါက စိတ်ကြိုက် ပြင်ဆင်နိုင်သည်)"
                app:helperTextTextColor="@color/hint_worker_id"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/hint_worker_id"
                app:boxStrokeWidth="1.5dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWorkerCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:text="W-109"
                    android:textColor="@color/text_main"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoWorkerCode"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"
                android:text="⚡ Auto"
                android:textColor="@color/badge_auto_text"
                android:textSize="12sp"
                app:backgroundTint="@color/badge_auto_bg"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Full Name with Colored Hint -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWorkerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Full Name (လုပ်သား အမည်)"
            app:hintTextColor="@color/hint_name"
            android:textColorHint="@color/hint_name"
            app:helperText="အမည် အပြည့်အစုံ ရိုက်ထည့်ပါ (ဥပမာ- ကိုအောင်ကို)"
            app:helperTextTextColor="@color/hint_name"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="@color/hint_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWorkerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Trade / Skill Category Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trade / Skill Category (ကျွမ်းကျင်မှု အမျိုးအစား)"
            android:textColor="@color/hint_trade"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerWorkerTrade"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/surface_variant" />

        <!-- Gender Selection Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gender (ကျား/မ ရွေးချယ်ရန်)"
            android:textColor="@color/primary_variant"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="2dp" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Male (ကျား)"
                android:textColor="@color/text_main" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Female (မ)"
                android:textColor="@color/text_main" />
        </RadioGroup>

        <!-- Rates in Row with Colored Hints (Wage & OT in Myanmar Kyats) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDailyRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Daily Wage (တစ်ရက်လုပ်ခ Ks)"
                app:hintTextColor="@color/hint_wage"
                android:textColorHint="@color/hint_wage"
                app:helperText="တစ်ရက် လုပ်ခ (ကျပ်)"
                app:helperTextTextColor="@color/hint_wage"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/hint_wage">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDailyRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="25000"
                    android:textColor="@color/text_main" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOtRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="OT Rate (အချိန်ပို Ks/hr)"
                app:hintTextColor="@color/hint_ot"
                android:textColorHint="@color/hint_ot"
                app:helperText="အချိန်ပို တစ်နာရီ (ကျပ်)"
                app:helperTextTextColor="@color/hint_ot"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/hint_ot">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOtRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="3500"
                    android:textColor="@color/text_main" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Phone Number with Colored Hint -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Phone Number (ဖုန်းနံပါတ်)"
            app:hintTextColor="@color/hint_phone"
            android:textColorHint="@color/hint_phone"
            app:helperText="ဆက်သွယ်ရန် ဖုန်းနံပါတ် (ဥပမာ- 09765432101)"
            app:helperTextTextColor="@color/hint_phone"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="@color/hint_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Assigned Site Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assigned Construction Site (တာဝန်ကျ ဆိုဒ်)"
            android:textColor="@color/hint_site"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerWorkerSite"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/surface_variant" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelWorker"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel (ပယ်ဖျက်)"
                android:textColor="@color/text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveWorker"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Save Worker (သိမ်းဆည်း)"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
