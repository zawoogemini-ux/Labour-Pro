<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_line"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Worker Info & Live Wage Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvWorkerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ramesh Kumar"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWorkerCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:background="@drawable/bg_rounded_card"
                        android:backgroundTint="@color/surface_variant"
                        android:text="W-101"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWorkerTrade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:background="@drawable/bg_badge_present"
                        android:text="Mason"
                        android:textColor="@color/status_present_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWorkerRates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rate: 25,000 Ks/day | OT: 3,500 Ks/h"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Live Calculated Wage Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvLiveEarned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25,000 Ks"
                    android:textColor="@color/secondary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveEarnedSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Day"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_line"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Ultra-Fast Shift & OT Control Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Morning Shift Toggles -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Morning (1st)"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:layout_marginBottom="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/btnMorningP"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="P"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_rounded_card"
                        android:backgroundTint="@color/status_present" />

                    <TextView
                        android:id="@+id/btnMorningHd"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="HD"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/btnMorningA"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="A"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/text_main" />
                </LinearLayout>
            </LinearLayout>

            <!-- Evening Shift Toggles -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evening (2nd)"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:layout_marginBottom="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/btnEveningP"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="P"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_rounded_card"
                        android:backgroundTint="@color/status_present" />

                    <TextView
                        android:id="@+id/btnEveningHd"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="HD"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/btnEveningA"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="A"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/text_main" />
                </LinearLayout>
            </LinearLayout>

            <!-- OT Stepper -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OT (Hours)"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:layout_marginBottom="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/btnOtMinus"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="–"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/tvOtValue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="0h"
                        android:textColor="@color/text_main"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnOtPlus"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Advance & Net Balance note if any -->
        <LinearLayout
            android:id="@+id/layoutAdvanceNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAdvanceDeductionInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Advance: 0 Ks"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvNetPayoutInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Net: 25,000 Ks"
                android:textColor="@color/status_present_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
